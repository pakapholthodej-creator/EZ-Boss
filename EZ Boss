local Tab2 = Window:CreateTab("ที่ช่วย", 4483362458)

-- 1. รีโหลดปืนอัตโนมัติ
Tab2:CreateToggle({
   Name = "1. รีโหลดปืนอัตโนมัติ",
   CurrentValue = false,
   Callback = function(Value)
       -- ระบบตรวจสอบกระสุนและกด R อัตโนมัติเมื่อกระสุนหมด
       if Value then
           task.spawn(function()
               while Value do
                   task.wait(0.5)
                   local vim = game:GetService("VirtualInputManager")
                   vim:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                   vim:SendKeyEvent(false, Enum.KeyCode.R, false, game)
               end
           end)
       end
   end,
})

