-- 3. ESP มองเห็นทะลุ / มองเห็นคนเป็นชื่อสีแดง
local ESPTable = {}
Tab2:CreateToggle({
   Name = "3. ESP มองทะลุคน (ชื่อสีแดง)",
   CurrentValue = false,
   Callback = function(Value)
       if Value then
           for _, plr in pairs(game.Players:GetPlayers()) do
               if plr ~= game.Players.LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
                   local Billboard = Instance.new("BillboardGui")
                   Billboard.Name = "ESP_DarkHack"
                   Billboard.AlwaysOnTop = true
                   Billboard.Size = UDim2.new(0, 100, 0, 40)
                   Billboard.StudsOffset = Vector3.new(0, 3, 0)
                   Billboard.Parent = plr.Character.Head

                   local Label = Instance.new("TextLabel")
                   Label.Size = UDim2.new(1, 0, 1, 0)
                   Label.Text = plr.Name
                   Label.TextColor3 = Color3.fromRGB(255, 0, 0) -- ชื่อสีแดง
                   Label.BackgroundTransparency = 1
                   Label.TextScaled = true
                   Label.Parent = Billboard
               end
           end
       else
           for _, plr in pairs(game.Players:GetPlayers()) do
               if plr.Character and plr.Character.Head:FindFirstChild("ESP_DarkHack") then
                   plr.Character.Head.ESP_DarkHack:Destroy()
               end
           end
       end
   end,
})

-- 4. เก็บของเร็วๆ (Instant Pickup)
Tab2:CreateToggle({
   Name = "4. เก็บของเร็ว (กดทีเดียวเข้าตัว)",
   CurrentValue = false,
   Callback = function(Value)
       if Value then
           for _, prompt in pairs(workspace:GetDescendants()) do
               if prompt:IsA("ProximityPrompt") then
                   prompt.HoldDuration = 0 -- กดแล้วเข้าตัวทันที
               end
           end
       end
   end,
})

-- 5. มองผู้เล่นที่กำลังเล่นอยู่ (Spectate)
local TargetPlayer = ""
Tab2:CreateInput({
   Name = "5. ใส่ชื่อผู้เล่นที่ต้องการส่อง",
   PlaceholderText = "พิมพ์ชื่อผู้เล่น...",
   RemoveTextAfterFocusLost = false,
   Callback = function(Text)
       TargetPlayer = Text
       local target = game.Players:FindFirstChild(TargetPlayer)
       if target and target.Character then
           workspace.CurrentCamera.CameraSubject = target.Character:FindFirstChildOfClass("Humanoid")
       else
           workspace.CurrentCamera.CameraSubject = game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
       end
   end,
})

